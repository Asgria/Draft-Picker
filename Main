<script>
// ============================================================
//  EDITABLE CONSTANTS
// ============================================================
const MASTER_LIST = [
"Alchemy", 
"Anatomy", 
"Druidism", 
"Mercantile", 
"ArmsLore", 
"Parry", 
"Begging", 
"Blacksmith", 
"Bowcraft", 
"Peacemaking", 
"Camping", 
"Carpentry", 
"Cartography", 
"Cooking", 
"Searching", 
"Discordance", 
"Psychology", 
"Healing", 
"Seafaring", 
"Forensics", 
"Herding", 
"Hiding", 
"Provocation", 
"Inscribe", 
"Lockpicking", 
"Magery", 
"MagicResist", 
"Tactics", 
"Snooping", 
"Musicianship", 
"Poisoning", 
"Marksmanship", 
"Spiritualism", 
"Stealing", 
"Tailoring", 
"Taming", 
"Tasting", 
"Tinkering", 
"Tracking", 
"Veterinary", 
"Swords", 
"Bludgeoning", 
"Fencing", 
"FistFighting", 
"Lumberjacking", 
"Mining", 
"Meditation", 
"Stealth", 
"RemoveTrap", 
"Necromancy", 
"Focus", 
"Knightship", 
"Bushido", 
"Ninjitsu", 
"Elementalism", 
"Free Pick"
];
const PREREQS = {
  "Blacksmith": ["Mining"],
  "Tinkering": ["Mining"],
  "Carpentry": ["Lumberjacking"],
  "Bowcraft": ["Lumberjacking"],
  "Magery": ["Psychology"],
  "Necromancy": ["Spiritualism"],
};
const WEIGHTED_CHANCE = 0.15;
const MAX_MILESTONE_SLOTS = 5;
const STARTER_COUNT = 4;
const XP_BASE = 500;
const PRESTIGE_GROWTH = 0.25;   // +25% per prestige
const LEVEL_GROWTH = 0.08;      // +8% XP required per level within a prestige
// ============================================================

const STORAGE_KEY = "draftPickerState_v4";
const FREE_PICK = "Free Pick";

let state = {
  remaining: [],
  picked: [],
  bans: {},
  milestones: Array(MAX_MILESTONE_SLOTS).fill(null),
  unlockedSlots: 0,
  level: 1,
  xp: 0,
  totalXp: 0,
  prestige: 0,
  rerolls: 0,
  generateCharges: 0,
  levelsSinceReward: 0
};

let currentMode = null;
let freePickCardEl = null;
let starterMode = false;
let starterCards = [];
let generateCards = [];       // current generate-3 set
let generateExclude = new Set(); // smart reroll: don't show these again this set

const $ = id => document.getElementById(id);
const cardsEl = $("cards");
const toastEl = $("toast");
const modal = $("pickModal");

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
function showToast(msg) {
  toastEl.textContent = msg;
  toastEl.classList.add("show");
  clearTimeout(showToast._t);
  showToast._t = setTimeout(() => toastEl.classList.remove("show"), 2400);
}
function hasPrereq(item) { return PREREQS[item] && PREREQS[item].length > 0; }
function prereqsMet(item) {
  if (!hasPrereq(item)) return true;
  return PREREQS[item].some(req => state.picked.includes(req));
}
function isBanned(item, context) {
  const b = state.bans[item];
  if (!b) return false;
  if (b === "full") return true;
  if (context === "starter" && b === "starter") return true;
  if (context === "generate" && b === "generate") return true;
  if (context === "any") return true;
  return false;
}

// XP scales with BOTH level and prestige
// level 1 prestige 0 → 500
// level 2 prestige 0 → 500 * 1.08
// level 1 prestige 1 → 500 * 1.25
// level 2 prestige 1 → 500 * 1.25 * 1.08
function xpRequired() {
  const prestigeMul = 1 + PRESTIGE_GROWTH * state.prestige;
  const levelMul = 1 + LEVEL_GROWTH * (state.level - 1);
  return Math.ceil(XP_BASE * prestigeMul * levelMul);
}

function buildPool(context, applyWeighting, excludeSet) {
  const pool = [];
  for (const item of state.remaining) {
    if (context === "starter" && item === FREE_PICK) continue;
    if (isBanned(item, context)) continue;
    if (item !== FREE_PICK && !prereqsMet(item)) continue;
    if (excludeSet && excludeSet.has(item)) continue;
    const weighted = hasPrereq(item);
    if (weighted && applyWeighting) {
      if (Math.random() < WEIGHTED_CHANCE) pool.push({ name: item, weighted: true });
    } else {
      pool.push({ name: item, weighted: weighted && item !== FREE_PICK });
    }
  }
  return pool;
}

function updateStatus() {
  const realRem = state.remaining.filter(x => x !== FREE_PICK).length;
  $("status").innerHTML =
    `Remaining: <strong>${realRem}</strong> · Picked: <strong>${state.picked.length}</strong> · Prestiged: <strong>${state.prestige}</strong> · Rerolls: <strong>${state.rerolls}</strong> · Generate charges: <strong>${state.generateCharges}</strong>`;

  $("levelDisplay").textContent = state.level;
  const need = xpRequired();
  $("xpText").textContent = `${state.xp} / ${need} XP`;
  $("xpBarFill").style.width = Math.min(100, (state.xp / need) * 100) + "%";
  $("totalXpDisplay").textContent = state.totalXp.toLocaleString();

  if (state.level >= 100) $("prestigeBtn").classList.add("show");
  else $("prestigeBtn").classList.remove("show");

  $("generate").disabled = state.generateCharges < 1;
  $("slotCountLabel").textContent =
    `(${state.milestones.filter(Boolean).length} filled · ${state.unlockedSlots}/${MAX_MILESTONE_SLOTS} unlocked)`;
}

function renderPicked() {
  const el = $("pickedList");
  if (!state.picked.length) {
    el.innerHTML = `<span class="no-picked">Nothing picked yet</span>`;
    return;
  }
  el.innerHTML = state.picked.map(item => `<span class="picked-item">${item}</span>`).join("");
}

function save() { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
function load() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return false;
    const data = JSON.parse(raw);
    if (!Array.isArray(data.remaining) || !Array.isArray(data.picked)) return false;
    state = Object.assign(state, data);
    while (state.milestones.length < MAX_MILESTONE_SLOTS) state.milestones.push(null);
    state.milestones = state.milestones.slice(0, MAX_MILESTONE_SLOTS);
    if (typeof state.totalXp !== "number") state.totalXp = 0;
    if (typeof state.generateCharges !== "number") state.generateCharges = 0;
    return true;
  } catch { return false; }
}

// ---------- Ban ----------
function renderBanSelect() {
  const options = MASTER_LIST.filter(c => c !== FREE_PICK && !state.bans[c]);
  $("banCardSelect").innerHTML = options.length
    ? options.map(c => `<option value="${c}">${c}</option>`).join("")
    : `<option value="">(none)</option>`;
}
function renderBans() {
  const entries = Object.entries(state.bans);
  if (!entries.length) {
    $("banList").innerHTML = `<span class="no-picked">No bans</span>`;
    return;
  }
  $("banList").innerHTML = entries.map(([name, type]) =>
    `<span class="ban-item">${name} <small style="opacity:0.7">(${type})</small><button data-unban="${name}">✕</button></span>`
  ).join("");
  $("banList").querySelectorAll("[data-unban]").forEach(btn => {
    btn.onclick = () => {
      delete state.bans[btn.dataset.unban];
      save(); renderBans(); renderBanSelect(); showToast("Ban removed");
    };
  });
}

// ---------- Milestones ----------
function syncMilestoneSlots() {
  // Prestige 0 = 0 slots, 1 = 1 slot, ... capped at MAX
  state.unlockedSlots = Math.min(state.prestige, MAX_MILESTONE_SLOTS);
}
function renderMilestones() {
  syncMilestoneSlots();
  const el = $("milestoneSlots");
  el.innerHTML = "";
  for (let i = 0; i < MAX_MILESTONE_SLOTS; i++) {
    const slot = document.createElement("div");
    slot.className = "slot";
    if (i >= state.unlockedSlots) {
      slot.innerHTML = `<span class="empty-label">Locked</span>`;
      slot.style.opacity = "0.4";
      slot.style.cursor = "default";
    } else if (state.milestones[i]) {
      slot.classList.add("filled");
      slot.innerHTML = `${state.milestones[i]} <button class="slot-remove" data-idx="${i}">✓</button>`;
      slot.querySelector("button").onclick = (e) => { e.stopPropagation(); claimMilestone(i); };
    } else {
      slot.innerHTML = `<span class="empty-label">+ Bank card</span>`;
      slot.onclick = () => openMilestonePicker(i);
    }
    el.appendChild(slot);
  }
  updateStatus();
}
function openMilestonePicker(slotIndex) {
  const choices = state.remaining.filter(x => x !== FREE_PICK && !isBanned(x, "any"));
  if (!choices.length) return showToast("No cards left to bank");
  $("modalTitle").textContent = "Bank a card into this slot";
  $("pickList").innerHTML = "";
  choices.forEach(item => {
    const btn = document.createElement("button");
    btn.textContent = item;
    btn.onclick = () => {
      state.milestones[slotIndex] = item;
      state.remaining = state.remaining.filter(x => x !== item);
      closeModal(); save(); renderMilestones(); updateStatus(); showToast("Banked: " + item);
    };
    $("pickList").appendChild(btn);
  });
  modal.classList.add("open");
}
function claimMilestone(idx) {
  const name = state.milestones[idx];
  if (!name) return;
  if (!state.picked.includes(name)) state.picked.push(name);
  state.milestones[idx] = null;
  save(); renderMilestones(); renderPicked(); updateStatus(); showToast("Claimed: " + name);
}

// ---------- XP / Level ----------
function addXP() {
  const amount = Math.max(0, parseInt($("xpInput").value, 10) || 0);
  if (amount <= 0) return showToast("Enter XP amount");
  $("xpInput").value = "";
  state.xp += amount;
  state.totalXp += amount;
  let leveled = 0;
  while (state.level < 100 && state.xp >= xpRequired()) {
    state.xp -= xpRequired();
    state.level += 1;
    leveled += 1;
    state.levelsSinceReward += 1;
    if (state.levelsSinceReward >= 4) {
      state.levelsSinceReward = 0;
      state.generateCharges += 1;
      showToast(`Level ${state.level}! +1 Generate charge`);
    }
  }
  if (state.level >= 100) {
    state.xp = 0;
    $("prestigeBtn").classList.add("show");
  }
  save(); updateStatus(); renderMilestones();
  if (leveled && state.levelsSinceReward !== 0) showToast(`+${amount} XP · +${leveled} level(s)`);
  else if (!leveled) showToast(`+${amount} XP`);
}

function doPrestige() {
  if (state.level < 100) return;
  if (!confirm("Prestige?\n• Level → 1\n• +5 rerolls\n• Soft-reset drafted cards\n• Keeps milestones & bans")) return;
  state.picked.forEach(c => {
    if (!state.remaining.includes(c) && c !== FREE_PICK) state.remaining.push(c);
  });
  if (MASTER_LIST.includes(FREE_PICK) && !state.remaining.includes(FREE_PICK)) state.remaining.push(FREE_PICK);
  state.picked = [];
  state.level = 1;
  state.xp = 0;
  state.prestige += 1;
  state.rerolls += 5;
  state.levelsSinceReward = 0;
  state.generateCharges = 0;
  syncMilestoneSlots();
  exitStarterMode();
  generateCards = [];
  save(); updateStatus(); renderPicked(); renderMilestones();
  cardsEl.innerHTML = `<p class="empty">Prestiged! Level 1 · +5 rerolls</p>`;
  showToast("Prestige #" + state.prestige);
}

function deathReset() {
  if (!confirm("Death Reset?\nReturns drafted cards to pool and restores Generate charges from your current level.\nKeeps milestones, levels, prestige, bans, rerolls.")) return;
  state.picked.forEach(c => { if (!state.remaining.includes(c)) state.remaining.push(c); });
  if (MASTER_LIST.includes(FREE_PICK) && !state.remaining.includes(FREE_PICK)) state.remaining.push(FREE_PICK);
  state.picked = [];
  // Restore generate charges based on level (every 4 levels = 1 charge)
  state.generateCharges = Math.floor(state.level / 4);
  state.levelsSinceReward = state.level % 4;
  exitStarterMode();
  generateCards = [];
  save(); updateStatus(); renderPicked();
  cardsEl.innerHTML = `<p class="empty">Death reset done. Generate charges restored.</p>`;
  showToast("Death reset · Generate charges restored");
}

function fullReset() {
  if (!confirm("FULL RESET? Wipes everything.")) return;
  state = {
    remaining: [...MASTER_LIST], picked: [], bans: {},
    milestones: Array(MAX_MILESTONE_SLOTS).fill(null),
    unlockedSlots: 0, level: 1, xp: 0, totalXp: 0, prestige: 0,
    rerolls: 0, generateCharges: 0, levelsSinceReward: 0
  };
  exitStarterMode();
  generateCards = [];
  localStorage.removeItem(STORAGE_KEY);
  save();
  updateStatus(); renderPicked(); renderBans(); renderBanSelect(); renderMilestones();
  cardsEl.innerHTML = `<p class="empty">Full reset.</p>`;
  showToast("Full reset");
}

// ---------- Modals ----------
function openPickModal(mode) {
  currentMode = mode;
  const choices = state.remaining.filter(x => x !== FREE_PICK && !isBanned(x, "any") && prereqsMet(x));
  if (!choices.length) return showToast("No items available");
  $("modalTitle").textContent = mode === "free" ? "Free Pick" : "Manual Pick";
  $("pickList").innerHTML = "";
  choices.forEach(item => {
    const btn = document.createElement("button");
    btn.textContent = item + (hasPrereq(item) ? " ★" : "");
    btn.onclick = () => finalizePick(item);
    $("pickList").appendChild(btn);
  });
  modal.classList.add("open");
}
function finalizePick(item) {
  state.remaining = state.remaining.filter(x => x !== item);
  if (!state.picked.includes(item)) state.picked.push(item);
  if (currentMode === "free" && freePickCardEl) {
    document.querySelectorAll(".card").forEach(c => {
      c.classList.remove("selected");
      c.style.pointerEvents = "none";
    });
    freePickCardEl.classList.add("selected");
    freePickCardEl.querySelector(".hint").textContent = "Locked in";
    freePickCardEl.querySelector(".name").textContent = item;
  }
  closeModal();
  save(); updateStatus(); renderPicked();
  showToast(currentMode === "free" ? "Free Pick → " + item : "Added: " + item);
}
function closeModal() {
  modal.classList.remove("open");
  currentMode = null;
  freePickCardEl = null;
}

// ---------- Generate 3 (gated + per-card smart reroll) ----------
function generate() {
  if (state.generateCharges < 1) return showToast("Need a Generate charge (every 4 levels)");
  exitStarterMode();
  state.generateCharges -= 1;
  generateExclude = new Set();
  const pool = buildPool("generate", true, generateExclude);
  if (!pool.length) {
    state.generateCharges += 1; // refund
    cardsEl.innerHTML = `<p class="empty">No available cards.</p>`;
    save(); updateStatus();
    return;
  }
  generateCards = shuffle(pool).slice(0, Math.min(3, pool.length));
  generateCards.forEach(c => generateExclude.add(c.name));
  save();
  updateStatus();
  renderGenerateCards();
}

function renderGenerateCards() {
  cardsEl.innerHTML = "";
  generateCards.forEach((entry, index) => {
    const item = entry.name;
    let cls = "card" + (item === FREE_PICK ? " freepick" : "") + (entry.weighted ? " weighted" : "");
    const card = document.createElement("div");
    card.className = cls;
    card.innerHTML = `
      ${entry.weighted ? '<div class="badge">Weighted</div>' : ''}
      <div class="number">#${index + 1}</div>
      <div class="name">${item}</div>
      <div class="hint">${item === FREE_PICK ? "Click to choose freely" : "Click to lock in"}</div>
      <button class="reroll-one" data-idx="${index}" ${state.rerolls < 1 ? "disabled" : ""}>Reroll (1 token)</button>
    `;
    card.querySelector(".name").parentElement?.querySelector(".hint");
    // Click card body to select (not the reroll button)
    card.addEventListener("click", (e) => {
      if (e.target.classList.contains("reroll-one")) return;
      if (item === FREE_PICK) {
        freePickCardEl = card;
        openPickModal("free");
      } else {
        selectItem(item, card);
      }
    });
    card.querySelector(".reroll-one").onclick = (e) => {
      e.stopPropagation();
      rerollOneGenerate(index);
    };
    cardsEl.appendChild(card);
  });
}

function rerollOneGenerate(idx) {
  if (state.rerolls < 1) return showToast("No reroll tokens");
  const old = generateCards[idx].name;
  // Smart: exclude all currently shown + already excluded this set
  const exclude = new Set(generateExclude);
  generateCards.forEach(c => exclude.add(c.name));

  const pool = buildPool("generate", true, exclude);
  if (!pool.length) return showToast("No other cards available to reroll into");

  const next = shuffle(pool)[0];
  generateCards[idx] = next;
  generateExclude.add(next.name);
  state.rerolls -= 1;
  save();
  updateStatus();
  renderGenerateCards();
  showToast(`Rerolled ${old} → ${next.name}`);
}

function selectItem(item, cardEl) {
  if (cardEl.classList.contains("selected")) return;
  document.querySelectorAll(".card").forEach(c => {
    c.classList.remove("selected");
    c.style.pointerEvents = "none";
  });
  cardEl.classList.add("selected");
  const hint = cardEl.querySelector(".hint");
  if (hint) hint.textContent = "Locked in";
  const rb = cardEl.querySelector(".reroll-one");
  if (rb) rb.remove();
  state.remaining = state.remaining.filter(x => x !== item);
  if (!state.picked.includes(item)) state.picked.push(item);
  generateCards = [];
  save(); updateStatus(); renderPicked();
  showToast("Locked: " + item);
}

// ---------- Starter ----------
function exitStarterMode() {
  starterMode = false;
  starterCards = [];
  $("starterBar").classList.remove("active");
}
function startStarter() {
  starterMode = true;
  generateCards = [];
  $("starterBar").classList.add("active");
  starterCards = [];
  drawStarter(true);
}
function drawStarter(full) {
  const pool = buildPool("starter", true, null);
  const lockedNames = starterCards.filter(c => c.locked).map(c => c.name);
  const available = pool.filter(p => !lockedNames.includes(p.name));
  if (full) {
    starterCards = shuffle(available).slice(0, Math.min(STARTER_COUNT, available.length))
      .map(p => ({ name: p.name, locked: false, weighted: p.weighted }));
  } else {
    const unlockedCount = starterCards.filter(c => !c.locked).length;
    const newDraws = shuffle(available).slice(0, unlockedCount);
    let i = 0;
    starterCards = starterCards.map(c => {
      if (c.locked) return c;
      if (i < newDraws.length) {
        const n = newDraws[i++];
        return { name: n.name, locked: false, weighted: n.weighted };
      }
      return c;
    });
  }
  renderStarter();
}
function renderStarter() {
  cardsEl.innerHTML = "";
  if (!starterCards.length) {
    cardsEl.innerHTML = `<p class="empty">No cards available for starter.</p>`;
    return;
  }
  starterCards.forEach((entry, index) => {
    const card = document.createElement("div");
    card.className = "card" + (entry.locked ? " locked" : "") + (entry.weighted ? " weighted" : "");
    card.innerHTML = `
      ${entry.weighted ? '<div class="badge">Weighted</div>' : ''}
      <div class="number">#${index + 1}</div>
      <div class="name">${entry.name}</div>
      <div class="hint">${entry.locked ? "Locked — click to unlock" : "Click to lock"}</div>
    `;
    card.onclick = () => { entry.locked = !entry.locked; renderStarter(); };
    cardsEl.appendChild(card);
  });
}
function rerollUnlocked() {
  if (!starterMode) return;
  if (!starterCards.some(c => !c.locked)) return showToast("Unlock at least one card to reroll");
  if (state.rerolls > 0) {
    state.rerolls -= 1;
    save(); updateStatus();
    showToast("Rerolled (−1 token)");
  } else {
    showToast("Rerolled");
  }
  drawStarter(false);
}
function finalizeStarter() {
  if (!starterMode || !starterCards.length) return;
  const names = starterCards.map(c => c.name);
  names.forEach(name => {
    if (!state.picked.includes(name)) state.picked.push(name);
    state.remaining = state.remaining.filter(x => x !== name);
  });
  exitStarterMode();
  cardsEl.innerHTML = `<p class="empty">Finalized! ${names.length} card(s) added.</p>`;
  save(); updateStatus(); renderPicked();
  showToast("Finalized: " + names.join(", "));
}

// ---------- Custom ----------
function doCustomPick() {
  const lines = $("customInput").value.split("\n").map(l => l.trim()).filter(Boolean);
  if (!lines.length) return showToast("Type at least one option");
  const chosen = lines[Math.floor(Math.random() * lines.length)];
  $("customResult").textContent = "→ " + chosen;
  $("customInput").value = "";
  showToast("Custom: " + chosen);
}

// ---------- Export / Import ----------
function exportSave() {
  const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "draft-save.json";
  a.click();
  showToast("Exported");
}
function importSave(file) {
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const data = JSON.parse(e.target.result);
      if (!Array.isArray(data.remaining) || !Array.isArray(data.picked)) throw new Error();
      state = Object.assign(state, data);
      while (state.milestones.length < MAX_MILESTONE_SLOTS) state.milestones.push(null);
      state.milestones = state.milestones.slice(0, MAX_MILESTONE_SLOTS);
      if (typeof state.totalXp !== "number") state.totalXp = 0;
      if (typeof state.generateCharges !== "number") state.generateCharges = 0;
      exitStarterMode();
      generateCards = [];
      save();
      renderAll();
      showToast("Imported");
    } catch { showToast("Invalid save file"); }
  };
  reader.readAsText(file);
}

function renderAll() {
  updateStatus();
  renderPicked();
  renderBans();
  renderBanSelect();
  renderMilestones();
}

// Events
$("starterBtn").onclick = startStarter;
$("generate").onclick = generate;
$("manualPick").onclick = () => openPickModal("manual");
$("banBtn").onclick = () => { renderBanSelect(); renderBans(); $("banModal").classList.add("open"); };
$("banClose").onclick = () => $("banModal").classList.remove("open");
$("banModal").onclick = (e) => { if (e.target === $("banModal")) $("banModal").classList.remove("open"); };
$("customBtn").onclick = () => { $("customResult").textContent = ""; $("customModal").classList.add("open"); };
$("customClose").onclick = () => $("customModal").classList.remove("open");
$("customModal").onclick = (e) => { if (e.target === $("customModal")) $("customModal").classList.remove("open"); };
$("export").onclick = exportSave;
$("import").onchange = (e) => {
  if (e.target.files[0]) { importSave(e.target.files[0]); e.target.value = ""; }
};
$("deathReset").onclick = deathReset;
$("reset").onclick = fullReset;
$("prestigeBtn").onclick = doPrestige;
$("addXpBtn").onclick = addXP;
$("rerollBtn").onclick = rerollUnlocked;
$("finalizeBtn").onclick = finalizeStarter;
$("cancelPick").onclick = closeModal;
modal.onclick = (e) => { if (e.target === modal) closeModal(); };
$("customPickBtn").onclick = doCustomPick;
$("banAddBtn").onclick = () => {
  const name = $("banCardSelect").value;
  const type = $("banTypeSelect").value;
  if (!name) return;
  state.bans[name] = type;
  save(); renderBans(); renderBanSelect();
  showToast("Banned " + name + " (" + type + ")");
};

if (!load()) {
  state.remaining = [...MASTER_LIST];
  state.milestones = Array(MAX_MILESTONE_SLOTS).fill(null);
}
if (MASTER_LIST.includes(FREE_PICK) && !state.remaining.includes(FREE_PICK) && !state.picked.includes(FREE_PICK)) {
  state.remaining.push(FREE_PICK);
}
renderAll();
</script>
</body>
</html>
