const $=id=>document.getElementById(id);
const on=(id,ev,fn)=>{const el=$(id); if(el) el[ev]=fn;};
const cardsEl=$("cards"), toastEl=$("toast"), modal=$("pickModal");

function shuffle(a){const x=[...a];for(let i=x.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]];}return x;}
function showToast(m){toastEl.textContent=m;toastEl.classList.add("show");clearTimeout(showToast._t);showToast._t=setTimeout(()=>toastEl.classList.remove("show"),2400);}
function hasPrereq(i){return PREREQS[i]&&PREREQS[i].length>0;}
function prereqsMet(i){
  if(state.mods.ignorePrereqs) return true;
  if(!hasPrereq(i)) return true;
  return PREREQS[i].some(r=>state.picked.includes(r));
}
function isBanned(item,ctx){
  const b=state.bans[item]; if(!b) return false;
  if(b==="full") return true;
  if(ctx==="starter"&&b==="starter") return true;
  if(ctx==="generate"&&b==="generate") return true;
  if(ctx==="any") return true;
  return false;
}
function levelsPerCharge(){
  if(state.mods.customInterval) return Math.max(1, parseInt(state.mods.levelsPerCharge,10)||4);
  return 4;
}
function xpRequired(){
  const p=1+PRESTIGE_GROWTH*state.prestige;
  const l=1+LEVEL_GROWTH*(state.level-1);
  return Math.ceil(XP_BASE*p*l);
}
function chargesPerAward(){ return Math.max(1, parseInt(state.mods.chargesPerAward,10)||1); }
function maxLevel(){ return Math.max(2, parseInt(state.mods.maxLevel,10)||100); }
function expectedChargesFromLevel(){
  const awards = Math.floor(state.level / levelsPerCharge());
  return awards * chargesPerAward();
}

function buildPool(ctx, applyW, exclude){
  const pool=[];
  for(const item of state.remaining){
    if(ctx==="starter"&&item===FREE_PICK) continue;
    if(isBanned(item,ctx)) continue;
    if(item!==FREE_PICK&&!prereqsMet(item)) continue;
    if(exclude&&exclude.has(item)) continue;
    const w=hasPrereq(item)&&!state.mods.ignorePrereqs;
    if(w&&applyW){ if(Math.random()<WEIGHTED_CHANCE) pool.push({name:item,weighted:true}); }
    else pool.push({name:item,weighted:w&&item!==FREE_PICK});
  }
  return pool;
}
function buildItemPool(exclude){
  return state.itemRemaining.filter(i=>!(exclude&&exclude.has(i))).map(n=>({name:n,weighted:false}));
}

function updateStatus(){
  const real=state.remaining.filter(x=>x!==FREE_PICK).length;
  let extra="";
  if(state.mods.starterLimitOn&&state.mods.starterMax) extra=` · Starter rerolls: <strong>${state.starterUses}/${state.mods.starterMax}</strong>`;
  $("status").innerHTML=`Save: <strong>${activeSaveName}</strong> · Remaining: <strong>${real}</strong> · Picked: <strong>${state.picked.length}</strong> · Prestiged: <strong>${state.prestige}</strong> · Rerolls: <strong>${state.rerolls}</strong> · Generate: <strong>${state.generateCharges}</strong>${extra}`;
  const maxL=maxLevel();
  const ld=$("levelDisplay");
  if(ld){
    ld.textContent=state.level;
    // update max level label next to it without destroying the node
    const parent=ld.parentElement;
    if(parent && parent.childNodes.length){
      // keep structure: Level <strong>X</strong> / max
      parent.innerHTML=`Level <strong id="levelDisplay">${state.level}</strong> / ${maxL}`;
    }
  }

  const need=xpRequired();
  $("xpText").textContent=`${state.xp} / ${need} XP`;
  $("xpBarFill").style.width=Math.min(100,(state.xp/need)*100)+"%";
  $("totalXpDisplay").textContent=state.totalXp.toLocaleString();
  if(state.level>=maxLevel()) $("prestigeBtn").classList.add("show"); else $("prestigeBtn").classList.remove("show");
  $("generate").disabled=state.generateCharges<1;
  $("generateItem").disabled=state.generateCharges<1;
  if(state.mods.itemDraft) $("generateItem").classList.add("show"); else $("generateItem").classList.remove("show");
  // Starter limit applies to Reroll Unlocked only, not starting a draft
  $("slotCountLabel").textContent=`(${state.milestones.filter(Boolean).length} filled · ${state.unlockedSlots}/${MAX_MILESTONE_SLOTS} unlocked)`;
}
function renderPicked(){
  const el=$("pickedList");
  const all=[...state.picked.map(i=>({n:i,t:"skill"})),...state.itemPicked.map(i=>({n:i,t:"item"}))];
  if(!all.length){el.innerHTML=`<span class="no-picked">Nothing picked yet</span>`;return;}
  const canRefund=!!(state.mods&&state.mods.draftReroll);
  el.innerHTML=all.map(x=>{
    const tip=x.t==="item"
      ? "Item you may use — drafted item unlock"
      : "Skill you may use — drafted skill unlock";
    const btn=canRefund
      ? ` <button data-refund-type="${x.t}" data-refund-name="${x.n}" title="Spend 1 reroll: return to pool and +1 Generate charge" style="background:transparent;border:none;color:#fdcb6e;cursor:pointer;padding:0 0 0 .25rem;">↩</button>`
      : "";
    return `<span class="picked-item" title="${tip}">${x.n}${x.t==="item"?" (item)":""}${btn}</span>`;
  }).join("");
  el.querySelectorAll("[data-refund-name]").forEach(b=>{
    b.onclick=(e)=>{
      e.stopPropagation();
      refundDrafted(b.dataset.refundType, b.dataset.refundName);
    };
  });
}
function refundDrafted(kind, name){
  if(!(state.mods&&state.mods.draftReroll)) return showToast("Enable “Reroll drafted” in Modifiers");
  if(state.rerolls<1) return showToast("No reroll tokens");
  if(kind==="item"){
    if(!state.itemPicked.includes(name)) return;
    state.itemPicked=state.itemPicked.filter(x=>x!==name);
    if(!state.itemRemaining.includes(name)) state.itemRemaining.push(name);
  } else {
    if(!state.picked.includes(name)) return;
    state.picked=state.picked.filter(x=>x!==name);
    if(!state.remaining.includes(name)) state.remaining.push(name);
  }
  state.rerolls-=1;
  state.generateCharges+=1;
  // chargesSpent tracks spends; refunding a generation does not undo past spends math
  save(); updateStatus(); renderPicked();
  showToast(`Returned ${name} · +1 Generate · −1 reroll`);
}
function cloneState(){ return JSON.parse(JSON.stringify(state)); }
function normalizeState(data){
  if(!data||!Array.isArray(data.remaining)||!Array.isArray(data.picked)) return null;
  const s = Object.assign({
    remaining:[], picked:[], bans:{},
    milestones:Array(MAX_MILESTONE_SLOTS).fill(null),
    unlockedSlots:0, level:1, xp:0, totalXp:0, prestige:0, rerolls:0,
    generateCharges:0, chargesSpent:0, levelsSinceReward:0, starterUses:0,
    mods:{ignorePrereqs:false,customInterval:false,levelsPerCharge:4,chargesPerAward:1,maxLevel:100,starterLimitOn:false,starterMax:null,itemDraft:false,itemMode:"packed",draftReroll:false,questsEnabled:false,questCooldownMinutes:60},
    itemRemaining:[], itemPicked:[]
  }, data);
  while(s.milestones.length<MAX_MILESTONE_SLOTS) s.milestones.push(null);
  s.milestones=s.milestones.slice(0,MAX_MILESTONE_SLOTS);
  if(!s.mods) s.mods={};
  s.mods = Object.assign({ignorePrereqs:false,customInterval:false,levelsPerCharge:4,chargesPerAward:1,maxLevel:100,starterLimitOn:false,starterMax:null,itemDraft:false,itemMode:"packed",draftReroll:false,questsEnabled:false,questCooldownMinutes:60}, s.mods);
  if(!Array.isArray(s.itemRemaining)) s.itemRemaining=defaultItemPool(s.mods.itemMode||"packed");
  if(!Array.isArray(s.itemPicked)) s.itemPicked=[];
  if(typeof s.chargesSpent!=="number") s.chargesSpent=0;
  if(typeof s.starterUses!=="number") s.starterUses=0;
  if(typeof s.mods.questsEnabled!=="boolean") s.mods.questsEnabled=false;
  if(typeof s.mods.questCooldownMinutes!=="number") s.mods.questCooldownMinutes=60;
  if(typeof s.questStreak!=="number") s.questStreak=0;
  if(typeof s.questCooldownUntil!=="number") s.questCooldownUntil=0;
  if(s.quest===undefined) s.quest=null;
  return s;
}
function readSavesStore(){
  try{
    const raw=localStorage.getItem(SAVES_KEY);
    if(raw){
      const store=JSON.parse(raw);
      if(store&&store.slots&&typeof store.slots==="object") return store;
    }
  }catch{}
  return { active:"Default", slots:{} };
}
function writeSavesStore(store){
  localStorage.setItem(SAVES_KEY, JSON.stringify(store));
}
function save(){
  const store=readSavesStore();
  store.active=activeSaveName;
  store.slots[activeSaveName]=cloneState();
  writeSavesStore(store);
  // keep legacy key in sync for old backups
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}
function load(){
  try{
    const store=readSavesStore();
    // migrate legacy single save if slots empty
    if(!Object.keys(store.slots).length){
      const legacy=localStorage.getItem(STORAGE_KEY);
      if(legacy){
        const data=JSON.parse(legacy);
        const n=normalizeState(data);
        if(n){
          store.slots["Default"]=n;
          store.active="Default";
          writeSavesStore(store);
        }
      }
    }
    if(!Object.keys(store.slots).length) return false;
    activeSaveName=store.active && store.slots[store.active] ? store.active : Object.keys(store.slots)[0];
    const n=normalizeState(store.slots[activeSaveName]);
    if(!n) return false;
    state=n;
    return true;
  }catch{return false;}
}
function switchSave(name){
  if(!name) return;
  const store=readSavesStore();
  if(!store.slots[name]) return showToast("Save not found");
  // persist current first
  store.slots[activeSaveName]=cloneState();
  activeSaveName=name;
  store.active=name;
  writeSavesStore(store);
  state=normalizeState(store.slots[name]);
  exitStarterMode(); generateCards=[]; pendingSelect=null; hideConfirm();
  renderAll();
  showToast("Loaded: "+name);
}
function createSave(name){
  name=(name||"").trim();
  if(!name) return showToast("Enter a name");
  const store=readSavesStore();
  if(store.slots[name]) return showToast("Name already exists");
  store.slots[activeSaveName]=cloneState();
  // new empty-ish run from defaults but keep same master lists structure via fullReset-like
  const fresh=normalizeState({
    remaining:[...MASTER_LIST], picked:[], bans:{},
    milestones:Array(MAX_MILESTONE_SLOTS).fill(null),
    unlockedSlots:0, level:1, xp:0, totalXp:0, prestige:0, rerolls:0,
    generateCharges:0, chargesSpent:0, levelsSinceReward:0, starterUses:0,
    mods:JSON.parse(JSON.stringify(state.mods)),
    itemRemaining:defaultItemPool((state.mods&&state.mods.itemMode)||"packed"),
    itemPicked:[]
  });
  store.slots[name]=fresh;
  activeSaveName=name;
  store.active=name;
  state=fresh;
  writeSavesStore(store);
  exitStarterMode(); generateCards=[]; pendingSelect=null; hideConfirm();
  renderAll();
  showToast("Created: "+name);
}
function deleteSave(name){
  const store=readSavesStore();
  if(Object.keys(store.slots).length<=1) return showToast("Keep at least one save");
  if(!store.slots[name]) return;
  if(!confirm("Delete save \""+name+"\"?")) return;
  delete store.slots[name];
  if(activeSaveName===name){
    activeSaveName=Object.keys(store.slots)[0];
    store.active=activeSaveName;
    state=normalizeState(store.slots[activeSaveName]);
  }
  writeSavesStore(store);
  renderAll();
  renderSavesList();
  showToast("Deleted: "+name);
}
function renameSave(oldName, newName){
  newName=(newName||"").trim();
  if(!newName) return showToast("Enter a name");
  const store=readSavesStore();
  if(!store.slots[oldName]) return;
  if(store.slots[newName]) return showToast("Name already exists");
  store.slots[newName]=store.slots[oldName];
  delete store.slots[oldName];
  if(activeSaveName===oldName) activeSaveName=newName;
  store.active=activeSaveName;
  writeSavesStore(store);
  renderSavesList();
  updateStatus();
  showToast("Renamed to "+newName);
}

function hideLanding(){
  const el=$("landing");
  if(el) el.classList.add("hidden");
}
function showLanding(){
  const el=$("landing");
  if(el) el.classList.remove("hidden");
  renderLandingList();
}
function renderLandingList(){
  const el=$("landingList");
  if(!el) return;
  const store=readSavesStore();
  const names=Object.keys(store.slots||{}).sort((a,b)=>a.localeCompare(b));
  if(!names.length){
    el.innerHTML=`<p style="color:#666;font-size:.9rem;text-align:center;padding:.5rem 0">No characters yet — create one below.</p>`;
    return;
  }
  el.innerHTML=names.map(n=>{
    const st=store.slots[n]||{};
    const meta=`Level ${st.level||1} · Picked ${(st.picked||[]).length} · Prestige ${st.prestige||0}`;
    return `<div class="landing-slot" data-play="${n}">
      <div><strong>${n}</strong><div class="meta">${meta}</div></div>
      <button type="button" data-play-btn="${n}">Play</button>
    </div>`;
  }).join("");
  el.querySelectorAll("[data-play]").forEach(row=>{
    row.onclick=(e)=>{
      if(e.target && e.target.getAttribute && e.target.getAttribute("data-play-btn")) return;
      enterSave(row.getAttribute("data-play"));
    };
  });
  el.querySelectorAll("[data-play-btn]").forEach(b=>{
    b.onclick=(e)=>{ e.stopPropagation(); enterSave(b.getAttribute("data-play-btn")); };
  });
}
function enterSave(name){
  if(!name) return;
  switchSave(name);
  hideLanding();
  showToast("Playing: "+name);
}
function landingCreate(){
  const name=(($("landingNewName")&&$("landingNewName").value)||"").trim();
  if(!name) return showToast("Enter a character name");
  createSave(name);
  if($("landingNewName")) $("landingNewName").value="";
  hideLanding();
}

function renderSavesList(){
  const store=readSavesStore();
  const el=$("savesList");
  if(!el) return;
  if($("activeSaveLabel")) $("activeSaveLabel").textContent=activeSaveName;
  const names=Object.keys(store.slots).sort((a,b)=>a.localeCompare(b));
  el.innerHTML=names.map(n=>{
    const st=store.slots[n]||{};
    const meta=`Lv ${st.level||1} · Picked ${(st.picked||[]).length} · Prestige ${st.prestige||0}`;
    const active=n===activeSaveName?' style="border-color:#00cec9"':'';
    return `<div style="background:#252530;border:1px solid #333;border-radius:8px;padding:.65rem .75rem;margin-bottom:.4rem;${active?';border-color:#00cec9;':''}">
      <div style="display:flex;justify-content:space-between;gap:.5rem;align-items:center;flex-wrap:wrap;">
        <div><strong>${n}</strong>${n===activeSaveName?' <span style="color:#00cec9;font-size:.75rem;">(active)</span>':''}<div style="font-size:.75rem;color:#888;margin-top:.15rem;">${meta}</div></div>
        <div style="display:flex;gap:.35rem;flex-wrap:wrap;">
          <button data-load="${n}" style="background:#6c5ce7;color:#fff;padding:.35rem .6rem;font-size:.8rem;">Load</button>
          <button data-rename="${n}" style="background:#2d2d38;color:#ccc;border:1px solid #3d3d4a;padding:.35rem .6rem;font-size:.8rem;">Rename</button>
          <button data-del="${n}" style="background:#5c2a2a;color:#f88;padding:.35rem .6rem;font-size:.8rem;">Delete</button>
        </div>
      </div>
    </div>`;
  }).join("")||'<span class="no-picked">No saves</span>';
  el.querySelectorAll("[data-load]").forEach(b=>b.onclick=()=>{switchSave(b.dataset.load);renderSavesList();});
  el.querySelectorAll("[data-del]").forEach(b=>b.onclick=()=>deleteSave(b.dataset.del));
  el.querySelectorAll("[data-rename]").forEach(b=>b.onclick=()=>{
    const nn=prompt("New name for \""+b.dataset.rename+"\":", b.dataset.rename);
    if(nn!=null) renameSave(b.dataset.rename, nn);
  });
}

function syncMilestoneSlots(){state.unlockedSlots=Math.min(state.prestige,MAX_MILESTONE_SLOTS);}
function renderMilestones(){
  syncMilestoneSlots();
  const el=$("milestoneSlots"); el.innerHTML="";
  for(let i=0;i<MAX_MILESTONE_SLOTS;i++){
    const slot=document.createElement("div"); slot.className="slot";
    if(i>=state.unlockedSlots){slot.innerHTML=`<span class="empty-label">Locked</span>`;slot.style.opacity=".4";slot.style.cursor="default";}
    else if(state.milestones[i]){
      slot.classList.add("filled");
      slot.innerHTML=`${state.milestones[i]} <button class="slot-remove" data-idx="${i}">✓</button>`;
      slot.querySelector("button").onclick=e=>{e.stopPropagation();claimMilestone(i);};
    } else {
      slot.innerHTML=`<span class="empty-label">+ Bank card</span>`;
      slot.onclick=()=>openMilestonePicker(i);
    }
    el.appendChild(slot);
  }
  updateStatus();
}
function openMilestonePicker(idx){
  const choices=state.remaining.filter(x=>x!==FREE_PICK&&!isBanned(x,"any"));
  if(!choices.length) return showToast("No cards to bank");
  $("modalTitle").textContent="Bank a card";
  $("pickList").innerHTML="";
  choices.forEach(item=>{
    const b=document.createElement("button"); b.textContent=item;
    b.onclick=()=>{state.milestones[idx]=item;state.remaining=state.remaining.filter(x=>x!==item);closeModal();save();renderMilestones();updateStatus();showToast("Banked: "+item);};
    $("pickList").appendChild(b);
  });
  modal.classList.add("open");
}
function claimMilestone(i){
  const n=state.milestones[i]; if(!n) return;
  if(!state.picked.includes(n)) state.picked.push(n);
  state.milestones[i]=null; save(); renderMilestones(); renderPicked(); updateStatus(); showToast("Claimed: "+n);
}

function addXP(){
  const amount=Math.max(0,parseInt($("xpInput").value,10)||0);
  if(amount<=0) return showToast("Enter XP");
  $("xpInput").value="";
  state.xp+=amount; state.totalXp+=amount;
  let leveled=0;
  const interval=levelsPerCharge();
  const per=chargesPerAward();
  const maxL=maxLevel();
  while(state.level<maxL&&state.xp>=xpRequired()){
    state.xp-=xpRequired(); state.level+=1; leveled+=1;
    state.levelsSinceReward+=1;
    if(state.levelsSinceReward>=interval){
      state.levelsSinceReward=0;
      state.generateCharges+=per;
      showToast(`Level ${state.level}! +${per} Generate charge(s)`);
    }
  }
  if(state.level>=maxL){state.xp=0;$("prestigeBtn").classList.add("show");}
  save(); updateStatus(); renderMilestones();
  if(leveled&&state.levelsSinceReward!==0) showToast(`+${amount} XP · +${leveled} level(s)`);
  else if(!leveled) showToast(`+${amount} XP`);
}

function applyModifiersRefresh(){
  const prevMode=state.mods.itemMode||"packed";
  state.mods.ignorePrereqs=$("modIgnorePrereq").checked;
  state.mods.customInterval=$("modCustomInterval").checked;
  state.mods.levelsPerCharge=Math.max(1,parseInt($("modInterval").value,10)||4);
  state.mods.chargesPerAward=Math.max(1,parseInt($("modChargesPer").value,10)||1);
  state.mods.maxLevel=Math.max(2,parseInt($("modMaxLevel").value,10)||100);
  state.mods.starterLimitOn=$("modStarterLimit").checked;
  const sm=$("modStarterMax").value;
  state.mods.starterMax=sm===""||sm===null?null:Math.max(1,parseInt(sm,10)||1);
  state.mods.itemDraft=$("modItemDraft").checked;
  state.mods.itemMode=$("modItemMode").value==="unpacked"?"unpacked":"packed";
  state.mods.draftReroll=$("modDraftReroll")?$("modDraftReroll").checked:false;
  state.mods.questsEnabled=$("modQuests")?$("modQuests").checked:false;
  state.mods.questCooldownMinutes=Math.max(1,parseInt($("modQuestCd")&&$("modQuestCd").value,10)||60);

  // Rebuild item pool when mode changes (preserve already-picked)
  if(state.mods.itemMode!==prevMode || true){
    rebuildItemPoolFromMode();
  }

  if(state.level>state.mods.maxLevel) state.level=state.mods.maxLevel;

  const expected=expectedChargesFromLevel();
  const newCharges=Math.max(0, expected - state.chargesSpent);
  const old=state.generateCharges;
  if(newCharges>old){
    state.generateCharges=newCharges;
    showToast(`Rules applied · Generate ${old} → ${newCharges}`);
  } else {
    showToast("Rules applied · item pool refreshed");
  }
  state.levelsSinceReward=state.level % levelsPerCharge();
  save(); updateStatus(); renderQuestLog();
}
function rebuildItemPoolFromMode(){
  const mode=state.mods.itemMode||"packed";
  const full=defaultItemPool(mode);
  // Keep items not yet picked that still belong in this mode
  const pickedSet=new Set(state.itemPicked);
  // If switching packed→unpacked, expand any picked packs into their items as picked
  if(mode==="unpacked"){
    const expanded=[];
    state.itemPicked.forEach(name=>{
      if(ITEM_PACKS[name]) expanded.push(...ITEM_PACKS[name]);
      else expanded.push(name);
    });
    state.itemPicked=[...new Set(expanded)];
  }
  // Remaining = full pool minus picked
  const picked=new Set(state.itemPicked);
  state.itemRemaining=full.filter(x=>!picked.has(x));
}

function doPrestige(){
  if(state.level<maxLevel()) return;
  if(!confirm("Prestige?\nLevel → 1 · +5 rerolls · soft-reset drafts · keeps milestones/bans")) return;
  state.picked.forEach(c=>{if(!state.remaining.includes(c)&&c!==FREE_PICK) state.remaining.push(c);});
  if(MASTER_LIST.includes(FREE_PICK)&&!state.remaining.includes(FREE_PICK)) state.remaining.push(FREE_PICK);
  state.picked=[]; state.level=1; state.xp=0; state.prestige+=1; state.rerolls+=5;
  state.levelsSinceReward=0; state.generateCharges=0; state.chargesSpent=0; state.starterUses=0;
  syncMilestoneSlots(); exitStarterMode(); generateCards=[]; pendingSelect=null; hideConfirm();
  save(); updateStatus(); renderPicked(); renderMilestones();
  cardsEl.innerHTML=`<p class="empty">Prestiged! Level 1 · +5 rerolls</p>`;
  showToast("Prestige #"+state.prestige);
}
function deathReset(){
  if(!confirm("Death Reset?\nReturn skill & item drafts to pool · restore Generate charges · reset starter reroll uses")) return;
  state.picked.forEach(c=>{if(!state.remaining.includes(c)) state.remaining.push(c);});
  if(MASTER_LIST.includes(FREE_PICK)&&!state.remaining.includes(FREE_PICK)) state.remaining.push(FREE_PICK);
  state.picked=[];
  // Return items
  state.itemPicked.forEach(c=>{if(!state.itemRemaining.includes(c)) state.itemRemaining.push(c);});
  state.itemPicked=[];
  state.generateCharges=expectedChargesFromLevel();
  state.chargesSpent=0;
  state.levelsSinceReward=state.level%levelsPerCharge();
  state.starterUses=0;
  exitStarterMode(); generateCards=[]; pendingSelect=null; hideConfirm();
  save(); updateStatus(); renderPicked();
  cardsEl.innerHTML=`<p class="empty">Death reset · charges & starter rerolls restored</p>`;
  showToast("Death reset");
}
function fullReset(){
  if(!confirm("FULL RESET the current save \""+activeSaveName+"\"?\nOther named saves are kept.")) return;
  state={
    remaining:[...MASTER_LIST],picked:[],bans:{},
    milestones:Array(MAX_MILESTONE_SLOTS).fill(null),unlockedSlots:0,
    level:1,xp:0,totalXp:0,prestige:0,rerolls:0,generateCharges:0,chargesSpent:0,
    levelsSinceReward:0,starterUses:0,
    mods:{ignorePrereqs:false,customInterval:false,levelsPerCharge:4,chargesPerAward:1,maxLevel:100,starterLimitOn:false,starterMax:null,itemDraft:false,itemMode:"packed",draftReroll:false,questsEnabled:false,questCooldownMinutes:60},
    itemRemaining:defaultItemPool("packed"),itemPicked:[],
    quest:null, questStreak:0, questCooldownUntil:0
  };
  exitStarterMode(); generateCards=[]; pendingSelect=null; hideConfirm();
  save();
  syncModUI(); updateStatus(); renderPicked(); renderBans(); renderBanSelect(); renderMilestones(); renderQuestLog();
  cardsEl.innerHTML=`<p class="empty">Full reset · ${activeSaveName}</p>`;
  showToast("Reset save: "+activeSaveName);
}

function hideConfirm(){const b=$("confirmBar"); if(b) b.style.display="none";}
function showConfirm(){const b=$("confirmBar"); if(b){ b.style.display="block"; b.style.visibility="visible"; }}

function openPickModal(mode){
  currentMode=mode;
  const choices=state.remaining.filter(x=>x!==FREE_PICK&&!isBanned(x,"any")&&prereqsMet(x));
  if(!choices.length) return showToast("None available");
  $("modalTitle").textContent=mode==="free"?"Free Pick":"Manual Pick";
  $("pickList").innerHTML="";
  choices.forEach(item=>{
    const b=document.createElement("button"); b.textContent=item+(hasPrereq(item)?" ★":"");
    b.onclick=()=>finalizePick(item); $("pickList").appendChild(b);
  });
  modal.classList.add("open");
}
function finalizePick(item){
  state.remaining=state.remaining.filter(x=>x!==item);
  if(!state.picked.includes(item)) state.picked.push(item);
  if(currentMode==="free"&&freePickCardEl){
    document.querySelectorAll(".card").forEach(c=>{c.classList.remove("selected","pending");c.style.pointerEvents="none";});
    freePickCardEl.classList.add("selected");
    freePickCardEl.querySelector(".hint").textContent="Locked in";
    freePickCardEl.querySelector(".name").textContent=item;
  }
  closeModal(); save(); updateStatus(); renderPicked();
  showToast(currentMode==="free"?"Free Pick → "+item:"Added: "+item);
}
function closeModal(){modal.classList.remove("open");currentMode=null;freePickCardEl=null;}

function spendCharge(){ state.generateCharges-=1; state.chargesSpent+=1; }

function generate(kind){
  if(state.generateCharges<1) return showToast("Need a Generate charge");
  exitStarterMode(); pendingSelect=null; hideConfirm();
  generateKind=kind||"skill";
  spendCharge();
  generateExclude=new Set();
  let pool;
  if(generateKind==="item"){
    pool=buildItemPool(generateExclude);
  } else {
    pool=buildPool("generate",true,generateExclude);
  }
  if(!pool.length){
    state.generateCharges+=1; state.chargesSpent=Math.max(0,state.chargesSpent-1);
    cardsEl.innerHTML=`<p class="empty">No available ${generateKind}s.</p>`;
    save(); updateStatus(); return;
  }
  generateCards=shuffle(pool).slice(0,Math.min(3,pool.length));
  generateCards.forEach(c=>generateExclude.add(c.name));
  save(); updateStatus();
  renderGenerateCards();
}
function renderGenerateCards(){
  cardsEl.innerHTML="";
  generateCards.forEach((entry,index)=>{
    const item=entry.name;
    let cls="card"+(item===FREE_PICK?" freepick":"")+(entry.weighted?" weighted":"");
    if(pendingSelect&&pendingSelect.item===item) cls+=" pending";
    const card=document.createElement("div"); card.className=cls;
    card.innerHTML=`${entry.weighted?'<div class="badge">Weighted</div>':''}<div class="number">#${index+1}</div><div class="name">${item}</div><div class="hint">${item===FREE_PICK?"Click to choose freely":"Click to select · Confirm to lock"}</div><button class="reroll-one" data-idx="${index}" ${state.rerolls<1?"disabled":""}>Reroll (1 token)</button>`;
    card.addEventListener("click",e=>{
      if(e.target.classList.contains("reroll-one")) return;
      if(item===FREE_PICK){ freePickCardEl=card; openPickModal("free"); return; }
      // pending select
      document.querySelectorAll(".card").forEach(c=>c.classList.remove("pending"));
      card.classList.add("pending");
      pendingSelect={item, cardEl:card, kind:generateKind, index};
      showConfirm();
    });
    const rb=card.querySelector(".reroll-one");
    if(rb) rb.onclick=e=>{e.stopPropagation();rerollOneGenerate(index);};
    cardsEl.appendChild(card);
  });
}
function rerollOneGenerate(idx){
  if(state.rerolls<1) return showToast("No reroll tokens");
  const old=generateCards[idx].name;
  const exclude=new Set(generateExclude);
  generateCards.forEach(c=>exclude.add(c.name));
  const pool=generateKind==="item"?buildItemPool(exclude):buildPool("generate",true,exclude);
  if(!pool.length) return showToast("Nothing else to reroll into");
  const next=shuffle(pool)[0];
  generateCards[idx]=next; generateExclude.add(next.name);
  state.rerolls-=1;
  if(pendingSelect&&pendingSelect.index===idx){pendingSelect=null;hideConfirm();}
  save(); updateStatus(); renderGenerateCards();
  showToast(`Rerolled ${old} → ${next.name}`);
}
function confirmSelection(){
  if(!pendingSelect) return showToast("Select a card first");
  const {item, cardEl, kind}=pendingSelect;
  document.querySelectorAll(".card").forEach(c=>{c.classList.remove("pending","selected");c.style.pointerEvents="none";});
  cardEl.classList.add("selected");
  const h=cardEl.querySelector(".hint"); if(h) h.textContent="Locked in";
  const rb=cardEl.querySelector(".reroll-one"); if(rb) rb.remove();
  if(kind==="item"){
    state.itemRemaining=state.itemRemaining.filter(x=>x!==item);
    if(!state.itemPicked.includes(item)) state.itemPicked.push(item);
  } else {
    state.remaining=state.remaining.filter(x=>x!==item);
    if(!state.picked.includes(item)) state.picked.push(item);
  }
  generateCards=[]; pendingSelect=null; hideConfirm();
  save(); updateStatus(); renderPicked();
  showToast("Locked: "+item);
}

function exitStarterMode(){starterMode=false;starterCards=[];$("starterBar").classList.remove("active");}
function startStarter(){
  starterMode=true; generateCards=[]; pendingSelect=null; hideConfirm();
  $("starterBar").classList.add("active"); starterCards=[];
  save(); updateStatus();
  drawStarter(true);
}
function drawStarter(full){
  const pool=buildPool("starter",true,null);
  const locked=starterCards.filter(c=>c.locked).map(c=>c.name);
  const avail=pool.filter(p=>!locked.includes(p.name));
  if(full){
    starterCards=shuffle(avail).slice(0,Math.min(STARTER_COUNT,avail.length)).map(p=>({name:p.name,locked:false,weighted:p.weighted}));
  } else {
    const n=starterCards.filter(c=>!c.locked).length;
    const draws=shuffle(avail).slice(0,n); let i=0;
    starterCards=starterCards.map(c=>{
      if(c.locked) return c;
      if(i<draws.length){const d=draws[i++];return {name:d.name,locked:false,weighted:d.weighted};}
      return c;
    });
  }
  renderStarter();
}
function renderStarter(){
  cardsEl.innerHTML="";
  if(!starterCards.length){cardsEl.innerHTML=`<p class="empty">No cards for starter</p>`;return;}
  starterCards.forEach((entry,index)=>{
    const card=document.createElement("div");
    card.className="card"+(entry.locked?" locked":"")+(entry.weighted?" weighted":"");
    card.innerHTML=`${entry.weighted?'<div class="badge">Weighted</div>':''}<div class="number">#${index+1}</div><div class="name">${entry.name}</div><div class="hint">${entry.locked?"Locked — click unlock":"Click to lock"}</div>`;
    card.onclick=()=>{entry.locked=!entry.locked;renderStarter();};
    cardsEl.appendChild(card);
  });
}
function rerollUnlocked(){
  if(!starterMode) return;
  if(!starterCards.some(c=>!c.locked)) return showToast("Unlock at least one to reroll");
  if(state.mods.starterLimitOn&&state.mods.starterMax!=null){
    if(state.starterUses>=state.mods.starterMax) return showToast("Starter reroll limit reached");
    state.starterUses+=1;
  }
  if(state.rerolls>0){state.rerolls-=1;showToast("Rerolled (−1 token)");}
  else showToast("Rerolled");
  save(); updateStatus();
  drawStarter(false);
}
function finalizeStarter(){
  if(!starterMode||!starterCards.length) return;
  const names=starterCards.map(c=>c.name);
  names.forEach(n=>{if(!state.picked.includes(n)) state.picked.push(n); state.remaining=state.remaining.filter(x=>x!==n);});
  exitStarterMode();
  cardsEl.innerHTML=`<p class="empty">Finalized! ${names.length} card(s)</p>`;
  save(); updateStatus(); renderPicked(); showToast("Finalized: "+names.join(", "));
}

function renderBanSelect(){
  const opts=MASTER_LIST.filter(c=>c!==FREE_PICK&&!state.bans[c]);
  $("banCardSelect").innerHTML=opts.length?opts.map(c=>`<option value="${c}">${c}</option>`).join(""):`<option value="">(none)</option>`;
}
function renderBans(){
  const e=Object.entries(state.bans);
  if(!e.length){$("banList").innerHTML=`<span class="no-picked">No bans</span>`;return;}
  $("banList").innerHTML=e.map(([n,t])=>`<span class="ban-item">${n} <small style="opacity:.7">(${t})</small><button data-unban="${n}">✕</button></span>`).join("");
  $("banList").querySelectorAll("[data-unban]").forEach(b=>{
    b.onclick=()=>{delete state.bans[b.dataset.unban];save();renderBans();renderBanSelect();showToast("Unbanned");};
  });
}
function syncModUI(){
  $("modIgnorePrereq").checked=!!state.mods.ignorePrereqs;
  $("modCustomInterval").checked=!!state.mods.customInterval;
  $("modInterval").value=state.mods.levelsPerCharge||4;
  if($("modChargesPer")) $("modChargesPer").value=state.mods.chargesPerAward||1;
  if($("modMaxLevel")) $("modMaxLevel").value=state.mods.maxLevel||100;
  $("modStarterLimit").checked=!!state.mods.starterLimitOn;
  $("modStarterMax").value=state.mods.starterMax==null?"":state.mods.starterMax;
  $("modItemDraft").checked=!!state.mods.itemDraft;
  if($("modItemMode")) $("modItemMode").value=state.mods.itemMode||"packed";
  if($("modDraftReroll")) $("modDraftReroll").checked=!!state.mods.draftReroll;
  if($("modQuests")) $("modQuests").checked=!!state.mods.questsEnabled;
  if($("modQuestCd")) $("modQuestCd").value=state.mods.questCooldownMinutes||60;
}
function syncEditUI(){
  $("editCharges").value=state.generateCharges;
  $("editChargesSpent").value=state.chargesSpent;
  $("editLevel").value=state.level;
  $("editXp").value=state.xp;
  $("editTotalXp").value=state.totalXp;
  $("editRerolls").value=state.rerolls;
  $("editPrestige").value=state.prestige;
  $("editStarterUses").value=state.starterUses;
}
function applyEditValues(){
  state.generateCharges=Math.max(0,parseInt($("editCharges").value,10)||0);
  state.chargesSpent=Math.max(0,parseInt($("editChargesSpent").value,10)||0);
  state.level=Math.max(1,Math.min(maxLevel(), parseInt($("editLevel").value,10)||1));
  state.xp=Math.max(0,parseInt($("editXp").value,10)||0);
  state.totalXp=Math.max(0,parseInt($("editTotalXp").value,10)||0);
  state.rerolls=Math.max(0,parseInt($("editRerolls").value,10)||0);
  state.prestige=Math.max(0,parseInt($("editPrestige").value,10)||0);
  state.starterUses=Math.max(0,parseInt($("editStarterUses").value,10)||0);
  save(); updateStatus(); renderMilestones();
  showToast("Values updated");
}
function doCustomPick(){
  const lines=$("customInput").value.split("\n").map(l=>l.trim()).filter(Boolean);
  if(!lines.length) return showToast("Type options");
  const c=lines[Math.floor(Math.random()*lines.length)];
  $("customResult").textContent="→ "+c; $("customInput").value=""; showToast("Custom: "+c);
}
async function exportSave(){
  // Only the active slot
  const payload={
    saveName: activeSaveName,
    exportedAt: new Date().toISOString(),
    state: cloneState()
  };
  const json=JSON.stringify(payload,null,2);
  const fname=(activeSaveName||"draft-save").replace(/[\\/:*?"<>|]/g,"_")+".json";
  try{
    if(window.showSaveFilePicker){
      const handle=await window.showSaveFilePicker({
        suggestedName: fname,
        types:[{description:"JSON Save", accept:{"application/json":[".json"]}}]
      });
      fileHandle=handle;
      const writable=await handle.createWritable();
      await writable.write(json);
      await writable.close();
      showToast("Exported (overwrite-capable) · "+activeSaveName);
      return;
    }
  }catch(e){
    if(e&&e.name==="AbortError") return;
  }
  // Fallback: fixed filename (browser may still append (1) if file exists in Downloads)
  const blob=new Blob([json],{type:"application/json"});
  const a=document.createElement("a");
  a.href=URL.createObjectURL(blob);
  a.download=fname;
  a.click();
  URL.revokeObjectURL(a.href);
  showToast("Exported active save · "+activeSaveName+" (check Downloads)");
}
function importSave(file){
  const r=new FileReader();
  r.onload=e=>{
    try{
      let d=JSON.parse(e.target.result);
      // support: {state:{...}}, {remaining:[...]}, or full slot dump
      if(d&&d.state&&typeof d.state==="object") d=d.state;
      if(d&&d.slots&&d.active&&d.slots[d.active]) d=d.slots[d.active];
      const n=normalizeState(d);
      if(!n) throw new Error("missing remaining/picked");
      // repair pools
      if(!n.remaining.length && n.picked.length < MASTER_LIST.length){
        const have=new Set(n.picked);
        n.remaining=MASTER_LIST.filter(x=>!have.has(x));
      }
      state=n;
      exitStarterMode(); generateCards=[]; pendingSelect=null; hideConfirm();
      save();
      syncModUI(); renderAll();
      showToast("Imported into: "+activeSaveName);
    }catch(err){
      console.error(err);
      showToast("Invalid save");
    }
  };
  r.readAsText(file);
}

function playerSkills(){ return new Set(state.picked||[]); }
function questEligible(def){
  if(!def) return false;
  const minLv = Math.max(1, parseInt(def.minLevel,10)||1);
  if((state.level||1) < minLv) return false;
  if(!def.requires||!def.requires.length) return true;
  const skills=playerSkills();
  return def.requires.some(r=>skills.has(r));
}
function questCooldownMs(){
  return Math.max(1, parseInt(state.mods.questCooldownMinutes,10)||60) * 60 * 1000;
}
function questOnCooldown(){
  return Date.now() < (state.questCooldownUntil||0);
}
function formatRemain(ms){
  const s=Math.max(0,Math.ceil(ms/1000));
  const m=Math.floor(s/60), r=s%60;
  return m+":"+String(r).padStart(2,"0");
}
function updateQuestButton(){
  const btn=$("questBtn");
  const rail=$("questRail");
  const enabled=!!(state.mods&&state.mods.questsEnabled);
  if(rail) rail.style.display = enabled ? "" : "none";
  if(!btn) return;
  if(!enabled){
    btn.classList.remove("show","cooldown");
    btn.style.display="none";
    btn.disabled=true;
    return;
  }
  btn.style.display="inline-flex";
  btn.classList.add("show");
  if(questOnCooldown()){
    btn.disabled=true;
    btn.classList.add("cooldown");
    const left=(state.questCooldownUntil||0)-Date.now();
    btn.textContent="Quest CD "+formatRemain(left);
  } else {
    btn.disabled=false;
    btn.classList.remove("cooldown");
    btn.textContent="Generate Quest";
  }
}
let _questTimer=null;
function ensureQuestTimer(){
  if(_questTimer) return;
  _questTimer=setInterval(()=>{
    updateQuestButton();
    if(!questOnCooldown() && _questTimer){
      // keep ticking while enabled so button recovers
    }
  }, 1000);
}
function rollQuestCount(def){
  const a=Math.max(1, parseInt(def.countMin,10)||1);
  const b=Math.max(a, parseInt(def.countMax,10)||a);
  return a + Math.floor(Math.random()*(b-a+1));
}
function generateQuest(){
  if(!(state.mods&&state.mods.questsEnabled)) return showToast("Enable Quests in Modifiers");
  if(questOnCooldown()) return showToast("Quest on cooldown");
  if(state.quest) return showToast("Finish or skip your current quest first");
  const pool=QUEST_DEFS.filter(questEligible);
  if(!pool.length) return showToast("No quests available for your drafted skills");
  const def=pool[Math.floor(Math.random()*pool.length)];
  const count=rollQuestCount(def);
  state.quest={
    defId: def.id,
    type: def.type,
    title: (def.title||"").replace(/\{x\}/gi, String(count)),
    description: def.description||"",
    count,
    reward: def.reward?{...def.reward}: {kind:"xp", value:0},
    requires: def.requires?[...def.requires]:[]
  };
  save(); renderQuestLog(); updateQuestButton();
  showToast("Quest assigned: "+state.quest.title);
}
function chainMultiplier(){
  // Bonus applies on the Nth completion in a row (e.g. 10th), then streak resets
  const next = (state.questStreak||0) + 1;
  return next >= QUEST_CHAIN_BONUS_AT ? QUEST_CHAIN_BONUS_MULT : 1;
}
function completeQuest(){
  if(!state.quest) return;
  const q=state.quest;
  const mult=chainMultiplier();
  let msg="";
  if(q.reward.kind==="xp"){
    const xp=Math.ceil((q.reward.value||0)*mult);
    // feed into XP system
    state.xp+=xp; state.totalXp+=xp;
    let leveled=0;
    const interval=levelsPerCharge();
    const per=chargesPerAward();
    const maxL=maxLevel();
    while(state.level<maxL&&state.xp>=xpRequired()){
      state.xp-=xpRequired(); state.level+=1; leveled+=1;
      state.levelsSinceReward+=1;
      if(state.levelsSinceReward>=interval){
        state.levelsSinceReward=0;
        state.generateCharges+=per;
      }
    }
    if(state.level>=maxL) state.xp=0;
    msg=`+${xp} XP`+(mult>1?` (${mult}× chain)`:"");
  } else if(q.reward.kind==="xp_pct"){
    // Typed XP (from kills) is granted in full, plus percentage bonus (chain multiplies the bonus only)
    const baseXp=Math.max(0, parseInt(($("questXpEarned")&&$("questXpEarned").value)||"0",10)||0);
    const bonus=Math.ceil(baseXp*(q.reward.value||0)*mult);
    const xp=baseXp+bonus;
    state.xp+=xp; state.totalXp+=xp;
    let leveled=0;
    const interval=levelsPerCharge();
    const per=chargesPerAward();
    const maxL=maxLevel();
    while(state.level<maxL&&state.xp>=xpRequired()){
      state.xp-=xpRequired(); state.level+=1; leveled+=1;
      state.levelsSinceReward+=1;
      if(state.levelsSinceReward>=interval){
        state.levelsSinceReward=0;
        state.generateCharges+=per;
      }
    }
    if(state.level>=maxL) state.xp=0;
    msg=`+${xp} XP (${baseXp} + ${bonus} bonus)`+(mult>1?` (bonus ${mult}× chain)`:"");
  } else {
    msg="Quest complete";
  }
  state.questStreak=(state.questStreak||0)+1;
  let streakMsg=state.questStreak;
  if(state.questStreak >= QUEST_CHAIN_BONUS_AT){
    streakMsg = state.questStreak + " (bonus!) → reset";
    state.questStreak = 0;
  }
  state.quest=null;
  state.questCooldownUntil=Date.now()+questCooldownMs();
  save(); renderQuestLog(); updateStatus(); renderMilestones();
  showToast(msg+" · chain "+streakMsg);
}
function skipQuest(){
  if(!state.quest) return;
  if(!confirm("Skip quest? This resets your quest chain streak.")) return;
  state.quest=null;
  state.questStreak=0;
  state.questCooldownUntil=Date.now()+questCooldownMs();
  save(); renderQuestLog(); updateQuestButton();
  showToast("Quest skipped · chain reset");
}
function resetQuestCooldown(){
  state.questCooldownUntil=0;
  save(); updateQuestButton();
  showToast("Quest cooldown cleared");
}
function renderQuestLog(){
  const body=$("questLogBody");
  if(!body) return;
  if(!(state.mods&&state.mods.questsEnabled)){
    body.innerHTML=`<p class="ql-empty">Quests disabled. Turn them on under Modifiers.</p>`;
    return;
  }
  const streak=state.questStreak||0;
  const nextBonus = QUEST_CHAIN_BONUS_AT - streak;
  const chainNote = nextBonus <= 0
    ? `Chain ready — next quest gets ×${QUEST_CHAIN_BONUS_MULT}, then resets`
    : `Chain <strong>${streak}</strong> / ${QUEST_CHAIN_BONUS_AT} — bonus on the ${QUEST_CHAIN_BONUS_AT}th, then resets`;
  if(!state.quest){
    body.innerHTML=`<p class="ql-empty">No active quest. Press <strong>Generate Quest</strong> when ready.</p>
      <div class="ql-chain">${chainNote}</div>`;
    return;
  }
  const q=state.quest;
  const type=q.type==="craft"?"craft":"kill";
  const typeLabel=type==="craft"?"Crafting":"Monster Slaying";
  let rewardLine="";
  if(q.reward.kind==="xp"){
    const base=q.reward.value||0;
    const mult=chainMultiplier();
    rewardLine=`Reward: <strong>${Math.ceil(base*mult)} XP</strong>`+(mult>1?` (base ${base} × chain)`:"");
  } else if(q.reward.kind==="xp_pct"){
    const pct=Math.round((q.reward.value||0)*100);
    rewardLine=`Reward: <strong>XP you enter</strong> + <strong>${pct}%</strong> bonus`+(chainMultiplier()>1?` (bonus ×${QUEST_CHAIN_BONUS_MULT} this quest)`:"");
  }
  const req=(q.requires||[]).join(", ")||"None";
  const xpField=q.reward.kind==="xp_pct"
    ? `<input class="ql-xp" id="questXpEarned" type="number" min="0" placeholder="XP earned from kills (full amount + bonus applied)">`
    : "";
  body.innerHTML=`
    <span class="ql-type ${type}">${typeLabel}</span>
    <div class="ql-title">${q.title}</div>
    <div class="ql-desc">${q.description||""}</div>
    <div class="ql-meta">${rewardLine}<br>Requires (any one): <strong>${req}</strong></div>
    ${xpField}
    <div class="ql-actions">
      <button class="ql-complete" id="questCompleteBtn">Finish</button>
      <button class="ql-skip" id="questSkipBtn">Skip Quest</button>
    </div>
    <div class="ql-chain">${chainNote}</div>`;
  const c=$("questCompleteBtn"); if(c) c.onclick=completeQuest;
  const s=$("questSkipBtn"); if(s) s.onclick=skipQuest;
}

function renderAll(){updateStatus();renderPicked();renderBans();renderBanSelect();renderMilestones();syncModUI();renderQuestLog();ensureQuestTimer();}

