const savesModal=$("savesModal"); if(savesModal) savesModal.onclick=e=>{if(e.target===savesModal)savesModal.classList.remove("open");};
bind("createSaveBtn", ()=>{createSave($("newSaveName").value); if($("newSaveName"))$("newSaveName").value=""; renderSavesList();});
bind("editBtn", ()=>{syncEditUI();$("editModal").classList.add("open");});
bind("editClose", ()=>$("editModal").classList.remove("open"));
const editModal=$("editModal"); if(editModal) editModal.onclick=e=>{if(e.target===editModal)editModal.classList.remove("open");};
bind("editApply", ()=>{applyEditValues();$("editModal").classList.remove("open");});
bind("customBtn", ()=>{if($("customResult"))$("customResult").textContent=""; $("customModal").classList.add("open");});
bind("customClose", ()=>$("customModal").classList.remove("open"));
const customModal=$("customModal"); if(customModal) customModal.onclick=e=>{if(e.target===customModal)customModal.classList.remove("open");};
bind("export", ()=>{ exportSave(); });
const importEl=$("import"); if(importEl) importEl.onchange=e=>{if(e.target.files[0]){importSave(e.target.files[0]);e.target.value="";}};
bind("deathReset", deathReset);
bind("reset", fullReset);
bind("resetQuestCd", resetQuestCooldown);
bind("prestigeBtn", doPrestige);
bind("addXpBtn", addXP);
bind("rerollBtn", rerollUnlocked);
bind("finalizeBtn", finalizeStarter);
bind("cancelPick", closeModal);
if(modal) modal.onclick=e=>{if(e.target===modal)closeModal();};
bind("customPickBtn", doCustomPick);
bind("banAddBtn", ()=>{
  const n=$("banCardSelect").value,t=$("banTypeSelect").value; if(!n) return;
  state.bans[n]=t; save(); renderBans(); renderBanSelect(); showToast("Banned "+n);
});

if(!load()){
  state.remaining=[...MASTER_LIST];
  state.milestones=Array(MAX_MILESTONE_SLOTS).fill(null);
  state.itemRemaining=defaultItemPool(state.mods.itemMode||"packed");
  activeSaveName = activeSaveName || "Default";
  save();
}
// Repair empty skill pool (corrupt / partial save)
if(!Array.isArray(state.remaining)) state.remaining=[];
if(!Array.isArray(state.picked)) state.picked=[];
if(state.remaining.length===0 && state.picked.length < MASTER_LIST.length){
  const have=new Set(state.picked);
  state.remaining=MASTER_LIST.filter(x=>!have.has(x));
}
if(MASTER_LIST.includes(FREE_PICK)&&!state.remaining.includes(FREE_PICK)&&!state.picked.includes(FREE_PICK))
  state.remaining.push(FREE_PICK);
if(!Array.isArray(state.itemRemaining) || (state.itemRemaining.length===0 && (!state.itemPicked||state.itemPicked.length===0))){
  state.itemRemaining=defaultItemPool((state.mods&&state.mods.itemMode)||"packed");
}
try { renderAll(); }
catch(e){ console.error(e); showToast("UI error — try Full Reset in Tools"); }
renderLandingList();
showLanding();

</script>
