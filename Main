const QUEST_CHAIN_BONUS_AT = 10; // streak needed
const QUEST_CHAIN_BONUS_MULT = 1.5; // +50% at streak

const WEIGHTED_CHANCE = 0.15;
const MAX_MILESTONE_SLOTS = 5;
const STARTER_COUNT = 4;
const XP_BASE = 500;
const PRESTIGE_GROWTH = 0.25;
const LEVEL_GROWTH = 0.08;
// ============================================================
const STORAGE_KEY = "draftPickerState_v6"; // legacy single-save migration
const SAVES_KEY = "draftPickerSaves_v7";
let activeSaveName = "Default";
let fileHandle = null;
const FREE_PICK = "Free Pick";

let state = {
  remaining:[], picked:[], bans:{},
  milestones:Array(MAX_MILESTONE_SLOTS).fill(null),
  unlockedSlots:0, level:1, xp:0, totalXp:0, prestige:0, rerolls:0,
  generateCharges:0, chargesSpent:0, levelsSinceReward:0,
  starterUses:0,
  mods:{
    ignorePrereqs:false,
    customInterval:false,
    levelsPerCharge:4,
    chargesPerAward:1,
    maxLevel:100,
    starterLimitOn:false,
    starterMax:null,
    itemDraft:false,
    itemMode:"packed"
  },
  itemRemaining:[],
  itemPicked:[],
  quest:null, // active quest instance
  questStreak:0,
  questCooldownUntil:0
};

let currentMode=null, freePickCardEl=null, starterMode=false, starterCards=[];
